{
  "info": {
    "name": "ASTHRA 2K26 — Imposter Backend",
    "_postman_id": "asthra-2k26-imposter",
    "description": "Full API test suite for the ASTHRA 2K26 Imposter event backend.\n\nSetup:\n1. Set `baseUrl` variable to your server (e.g. http://localhost:3000)\n2. Run `POST /api/admin/login` once — the collection auto-saves the token to `adminToken`\n3. After authenticating a participant, the collection auto-saves `participantId`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:3000",  "type": "string" },
    { "key": "adminToken",   "value": "",                       "type": "string" },
    { "key": "participantId","value": "",                       "type": "string" }
  ],
  "item": [

    {
      "name": "🟢 Public — Health & Root",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "description": "Returns DB connectivity status and missing tables list."
          }
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "Returns project name and version."
          }
        }
      ]
    },

    {
      "name": "🔐 Auth — Participant",
      "item": [
        {
          "name": "Authenticate Participant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.user && r.user.id) {",
                  "  pm.collectionVariables.set('participantId', r.user.id);",
                  "  console.log('participantId saved:', r.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/authenticate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"team_name\": \"Team Alpha\"\n}"
            },
            "description": "Authenticate a participant by name + team name. Saves participantId to collection variable."
          }
        }
      ]
    },

    {
      "name": "👤 Participant — My Data",
      "item": [
        {
          "name": "Get My Assignment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/my-assignment/{{participantId}}",
            "description": "Returns the participant's shuffled role, task, and assignment details."
          }
        },
        {
          "name": "Get My Scores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/my-scores/{{participantId}}",
            "description": "Returns the participant's current scores across all events."
          }
        }
      ]
    },

    {
      "name": "📤 Participant — Submissions",
      "item": [
        {
          "name": "Submit GitHub Repo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/submit-github",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\",\n  \"github_repo\": \"https://github.com/octocat/Hello-World\"\n}"
            },
            "description": "Submit a GitHub repository URL. Validates the repo exists before locking."
          }
        },
        {
          "name": "Check Submission Status (global)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/submission-status",
            "description": "Returns whether submissions are currently open (admin toggle)."
          }
        },
        {
          "name": "FizzBuzz — Submit Code (v2)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/fizzbuzz/submit-v2",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\",\n  \"fizz_output\": \"1\\n2\\nFizz\\n4\\nBuzz\\nFizz\\n7\\n8\\nFizz\\nBuzz\\n11\\nFizz\\n13\\n14\\n15\",\n  \"language\": \"python\"\n}"
            },
            "description": "Submit FizzBuzz code/output. One submission per shuffled group."
          }
        },
        {
          "name": "FizzBuzz — Get Status (toggle)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/fizzbuzz/toggle",
            "description": "Returns whether the FizzBuzz round is currently active."
          }
        },
        {
          "name": "FizzBuzz — Group Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/fizzbuzz/group-status/Group-A1",
            "description": "Check if a specific shuffled group has already submitted FizzBuzz."
          }
        },
        {
          "name": "FizzBuzz — Participant Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/fizzbuzz/status/{{participantId}}",
            "description": "Returns FizzBuzz submission status for a specific participant."
          }
        },
        {
          "name": "Code Imposter — Submit Completion Time",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/code-imposter/submit",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_name\": \"Alice\",\n  \"participant_id\": \"{{participantId}}\",\n  \"completion_time\": \"00:02:35\"\n}"
            },
            "description": "Record the time a participant took to complete the Code Imposter challenge."
          }
        }
      ]
    },

    {
      "name": "⏱ Timers (Public)",
      "item": [
        {
          "name": "Get All Event Timers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/event-timers",
            "description": "Returns current state of all event timers (fizzbuzz, main_event, etc.)."
          }
        },
        {
          "name": "Get Single Timer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/timer/fizzbuzz",
            "description": "Returns timer state for a specific event. Replace 'fizzbuzz' with: main_event, code_imposter, sherlock, drawing."
          }
        }
      ]
    },

    {
      "name": "🔑 Admin — Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.token) {",
                  "  pm.collectionVariables.set('adminToken', r.token);",
                  "  console.log('adminToken saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"YOUR_ADMIN_SECRET_HERE\"\n}"
            },
            "description": "Login with admin secret. Auto-saves Bearer token to `adminToken` variable."
          }
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "description": "Invalidates the current admin session token."
          }
        }
      ]
    },

    {
      "name": "🏁 Admin — Registration & Shuffle",
      "item": [
        {
          "name": "Register Team",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/register-team",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_name\": \"Team Alpha\",\n  \"members\": [\"Alice\", \"Bob\", \"Charlie\", \"Diana\"]\n}"
            },
            "description": "Register a team with exactly 4 member names."
          }
        },
        {
          "name": "Get Registered Teams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/registered-teams",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "description": "List all registered teams with their participants."
          }
        },
        {
          "name": "Get Shuffle Layout (preview)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shuffle-layout",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "description": "Preview what the shuffle will look like before running it."
          }
        },
        {
          "name": "Start Shuffle",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/start-shuffle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Run the participant shuffle and assign shuffled groups + roles."
          }
        },
        {
          "name": "Get Shuffle Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/shuffle-status",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Unlock Shuffle",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/unlock-shuffle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Lock Shuffle",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/lock-shuffle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },

    {
      "name": "⏱ Admin — Timers",
      "item": [
        {
          "name": "Get All Timers (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/timers",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Timer — Start (fizzbuzz)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/event/start",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventKey\": \"fizzbuzz\",\n  \"duration\": 600\n}"
            },
            "description": "Start a timer. eventKey: fizzbuzz | main_event | code_imposter | sherlock | drawing"
          }
        },
        {
          "name": "Timer — Pause",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/event/pause",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventKey\": \"fizzbuzz\"\n}" }
          }
        },
        {
          "name": "Timer — Resume",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/event/resume",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventKey\": \"fizzbuzz\"\n}" }
          }
        },
        {
          "name": "Timer — Reset",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/event/reset",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventKey\": \"fizzbuzz\"\n}" }
          }
        },
        {
          "name": "Timer — Finish",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/event/finish",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventKey\": \"fizzbuzz\"\n}" }
          }
        }
      ]
    },

    {
      "name": "📊 Admin — Scores & Evaluation",
      "item": [
        {
          "name": "Get Overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/overview",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get All Participants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/participants",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Team Scores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/team-scores",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Podium",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/podium",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Event Progress",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/event-progress",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Trigger AI Evaluation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/evaluate-submission/{{participantId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retry\": false,\n  \"force\": false\n}"
            },
            "description": "Trigger Groq AI evaluation for a participant. Set retry:true to re-evaluate an already-evaluated submission."
          }
        },
        {
          "name": "Get Main Event Scores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/main-event-scores",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Save Main Event Score (manual override)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/save-main-event-score",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\",\n  \"score\": 75\n}"
            }
          }
        },
        {
          "name": "Update Main Event Score",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/update-main-event-score",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\",\n  \"score\": 80\n}"
            }
          }
        },
        {
          "name": "Save Manual Event Score",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/manual-score",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"Code Imposter\",\n  \"original_team\": \"Team Alpha\",\n  \"marks\": 85\n}"
            },
            "description": "event_name must be one of: Code Imposter | Sherlock Holmes | Drawing"
          }
        },
        {
          "name": "Get Manual Scores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/manual-scores",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Mark Participant as Evaluated",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/mark-evaluated",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\"\n}"
            }
          }
        },
        {
          "name": "Recover Failed Evaluations",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/recover-evaluations",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "description": "Re-queues all participants with status Failed or stuck Evaluating."
          }
        },
        {
          "name": "Unlock Submission",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/unlock-submission",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participantId}}\"\n}"
            },
            "description": "Unlocks a participant's submission so they can resubmit."
          }
        },
        {
          "name": "Toggle Submissions Open/Closed",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/toggle-submissions",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"open\": true\n}"
            },
            "description": "Set open:true to allow GitHub submissions, false to close them."
          }
        }
      ]
    },

    {
      "name": "🎯 Admin — FizzBuzz",
      "item": [
        {
          "name": "Get All FizzBuzz Submissions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fizzbuzz/all-submissions",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get FizzBuzz Submissions (v2)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fizzbuzz/submissions-v2",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Run FizzBuzz Code",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fizzbuzz/run-code",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shuffled_group\": \"Group-A1\",\n  \"language\": \"python\"\n}"
            },
            "description": "Execute the submitted FizzBuzz code locally (disabled on Vercel)."
          }
        },
        {
          "name": "Score FizzBuzz Group",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fizzbuzz/score-v2",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shuffled_group\": \"Group-A1\",\n  \"is_correct\": true\n}"
            }
          }
        },
        {
          "name": "Save FizzBuzz Group Score",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/save-fizzbuzz-group-score",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shuffled_group\": \"Group-A1\",\n  \"group_score\": 20,\n  \"imposter_bonus\": true\n}"
            },
            "description": "Saves group score to all members. If imposter_bonus=true, imposter gets +10."
          }
        },
        {
          "name": "Get FizzBuzz Scores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fizzbuzz-scores",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Save FizzBuzz Score (per team)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/save-fizzbuzz-score",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_team\": \"Team Alpha\",\n  \"marks\": 20\n}"
            }
          }
        },
        {
          "name": "Toggle FizzBuzz Round",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fizzbuzz/toggle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"open\": true\n}"
            }
          }
        }
      ]
    },

    {
      "name": "📋 Admin — Audit & Code Imposter",
      "item": [
        {
          "name": "Get Audit Log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/audit-log",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Code Imposter Submissions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/code-imposter-submissions",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Cohort Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/cohort-report",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Cohort Report (by task number)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/cohort-report/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }

  ]
}
