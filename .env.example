# ─────────────────────────────────────────────────
#  ASTHRA 2K26 — IMPOSTER PROJECT  |  .env.example
#  Copy this file to .env and fill in all values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────
# Project URL from Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — safe to use server-side
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Groq AI (code evaluation) ─────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub (repository validation) ───────────────
# Personal Access Token with repo:read scope.
# Without this, GitHub API allows only 60 req/hr.
# With PAT: 5000 req/hr. REQUIRED for event day.
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin authentication ──────────────────────────
# Any strong random string (min 32 chars).
# Used for POST /api/admin/login  → Bearer token auth.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=secrets@admin

# ── CORS ──────────────────────────────────────────
# The exact origin of your frontend.
# On Vercel this is your deployment URL, e.g. https://imposter-astra.vercel.app
# For local development use http://localhost:3000 or leave empty (defaults to same-origin).
FRONTEND_ORIGIN=https://your-project.vercel.app

# ── Server ────────────────────────────────────────
# Only used for local development (Vercel ignores PORT).
PORT=3000
